# Absolute API origin. LEAVE EMPTY for web deploys: api.js
# already prefixes "/api/v1", and nginx proxies /api to the
# backend, so an empty value keeps URLs same-origin relative.
# Setting "/api/v1" here would double-prefix every request.
#
# VITE_API_URL=

# Absolute WebSocket origin (same story - empty is same-origin).
# VITE_WS_URL=wss://chat.example.com

# Native shells (Capacitor): bake the server with
#   Mobile/dev-build.ps1        (LAN dev, auto-detects IP)
# The bundle also honours a runtime override that wins over
# both of the values above:
#   localStorage.setItem("nexara.server_url", "http://<host>:<port>")
