{
    "name": "nexara-mobile",
    "private": true,
    "version": "1.0.0",
    "description": "Capacitor native shell (Android/iOS) wrapping the Nexara web frontend",
    "scripts": {
        "sync": "cd ../frontend && npm run build && cd ../Mobile && npx cap sync",
        "add:android": "npx cap add android",
        "open:android": "npx cap open android",
        "build:dev": "powershell -ExecutionPolicy Bypass -File ./dev-build.ps1",
        "build:prod": "powershell -ExecutionPolicy Bypass -File ./prod-build.ps1"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.0",
        "@capacitor/app": "^8.1.1",
        "@capacitor/core": "^8.5.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.0"
    }
}
