APP_NAME=Nexara
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/nexara

# Optional. Only for running Alembic locally: the RLS policies and
# SECURITY DEFINER helpers require the schema owner (superuser), which
# the least-privilege app role is not. Falls back to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql+asyncpg://postgres:password@localhost:5432/nexara

# SECRET_KEY - required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup fails in production if this is missing, shorter than
# 32 chars, or still the CHANGE_ME placeholder.
# In production, MUST set a secure random value.
SECRET_KEY=CHANGE_ME

JWT_ALGORITHM=HS256

# For ES256 instead of HS256, provide PEM-encoded key pair.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Refresh-token cookie transport
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Redis (rate limiting; falls back to in-memory when empty)
# REDIS_URL=redis://localhost:6379/0

# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated hosts accepted by TrustedHost (dev default allows all)
ALLOWED_HOSTS=*

# Frontend URL for recovery link emails
FRONTEND_URL=http://localhost:5173

# SMTP (required for OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Nexara

# WebRTC TURN servers (optional; comma-separated, empty = STUN only)
# TURN_URLS=turn:your-turn-server:3478?transport=udp
# TURN_USERNAME=
# TURN_PASSWORD=

# Optional Sentry DSN for error tracking (leave empty to disable)
# SENTRY_DSN=https://xxx@sentry.io/xxx
