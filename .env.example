# Nexara Environment Configuration Template
# Copy this to .env and fill in your values

# ==========================================================
# Application Settings
# ==========================================================
APP_NAME=Nexara
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ==========================================================
# Security Secrets (REQUIRED)
# Generate with:
#   SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   TURN_SECRET: openssl rand -hex 32
# ==========================================================
SECRET_KEY=CHANGE_ME_generate_with_command_above
TURN_SECRET=CHANGE_ME_generate_with_command_above

# ==========================================================
# Database
# ==========================================================
POSTGRES_USER=nexara
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=nexara

# ==========================================================
# Domain & URLs
# ==========================================================
FRONTEND_URL=https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com
CORS_ORIGINS=https://yourdomain.com
TURN_REALM=yourdomain.com

# ==========================================================
# SMTP Email (Required for OTP login)
# For Gmail: Use App Password (not regular password)
# https://support.google.com/accounts/answer/185833
# ==========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Nexara

# ==========================================================
# TURN Server (Automatically configured - no changes needed)
# ==========================================================
TURN_URLS=turn:coturn:3478?transport=udp
TURN_USERNAME=nexara
# TURN_PASSWORD uses TURN_SECRET automatically

# ==========================================================
# Optional: Sentry Error Tracking
# ==========================================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==========================================================
# Optional: Cloudflare Turnstile (CAPTCHA)
# ==========================================================
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ==========================================================
# WebAuthn / Passkeys (relying party identity)
# In production set to your real domain (e.g. nexara.example.com)
# ==========================================================
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Nexara
